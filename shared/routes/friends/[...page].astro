---
import FriendsPage from "@/components/pages/FriendsPage.astro";
import { FEATURES } from "@/site.config";

// Rest parameter route so the page can be excluded entirely when the flag is
// off: getStaticPaths only runs for dynamic routes.
export function getStaticPaths() {
  return FEATURES.portfolio.enabled && FEATURES.portfolio.friends
    ? [{ params: { page: undefined }, props: {} }]
    : [];
}
---

<FriendsPage locale="fr" />
