{
  "name": "lisible",
  "version": "0.1.0",
  "private": true,
  "description": "A minimal, fast, reading-first blog framework for Astro: six visual variants, one shared core.",
  "license": "MIT",
  "homepage": "https://github.com/didntchooseaname/lisible",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/didntchooseaname/lisible.git"
  },
  "bugs": {
    "url": "https://github.com/didntchooseaname/lisible/issues"
  },
  "keywords": [
    "astro",
    "blog",
    "blog-template",
    "static-site",
    "i18n",
    "bun"
  ],
  "type": "module",
  "scripts": {
    "init": "bun scripts/init.ts",
    "new-post": "bun scripts/new-post.ts",
    "dev": "bun scripts/run.ts dev",
    "build": "bun scripts/run.ts build",
    "preview": "bun scripts/run.ts preview",
    "check-links": "bun scripts/check-links.ts",
    "check-assets": "bun scripts/check-assets.ts",
    "sync-og-assets": "bun scripts/sync-og-assets.ts",
    "check-og-assets": "bun scripts/sync-og-assets.ts --check",
    "check-og-output": "bun scripts/check-og-output.ts",
    "check-style": "bun scripts/check-style.ts",
    "check:all": "bun scripts/check-variants.ts",
    "variant": "bun scripts/run.ts which",
    "preview:all": "bun scripts/preview-all.ts",
    "check-variants": "bun scripts/check-variants.ts",
    "check-drift": "bun scripts/check-drift.ts",
    "test": "bun test",
    "test:e2e": "bun x playwright test",
    "lint": "bun x biome check .",
    "format": "bun x biome format --write .",
    "typecheck": "bun scripts/check-variants.ts --typecheck-only"
  },
  "devDependencies": {
    "@astrojs/rss": "^4.0.19",
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "^2.5.5",
    "@happy-dom/global-registrator": "^20.11.1",
    "@playwright/test": "^1.62.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "clsx": "^2.1.1",
    "happy-dom": "^20.11.1",
    "hastscript": "^9.0.1",
    "open-graph-scraper": "^6.12.0",
    "satori": "^0.29.0",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  }
}
