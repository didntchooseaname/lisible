---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { localeUrl, t, type Locale } from "@/i18n/ui";
import avatarA from "@shared/assets/demo-friend-a.svg?url";
import avatarB from "@shared/assets/demo-friend-b.svg?url";
import avatarC from "@shared/assets/demo-friend-c.svg?url";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const isFrench = locale === "fr";
const alternates = { fr: localeUrl("fr", "friends"), en: localeUrl("en", "friends") };

const DEMO_AVATARS: Record<string, string> = { a: avatarA, b: avatarB, c: avatarC };
const friends = (await getCollection("friends")).map(({ data }) => ({
  name: data.name,
  avatar: DEMO_AVATARS[data.avatar] ?? data.avatar,
  bio: isFrench ? data.bio.fr : data.bio.en,
  url: data.url ?? "https://example.com",
}));
---

<BaseLayout
  locale={locale}
  title={dict.nav.friends}
  description={isFrench ? "Communauté fictive utilisée pour la démonstration de Lisible." : "A fictional community used for the Lisible demo."}
  alternates={alternates}
>
  <section class="py-10 md:py-14">
    <p class="text-xs font-semibold uppercase tracking-wider text-accent">
      {isFrench ? "Communauté de démonstration" : "Demo community"}
    </p>
    <h1 class="friends-title mt-2 text-3xl font-bold tracking-tight md:text-4xl">
      {dict.nav.friends}
    </h1>
    <p class="mt-4 max-w-2xl text-muted-foreground">
      {isFrench
        ? "Tous les noms, portraits et profils de cette page sont fictifs."
        : "Every name, portrait and profile on this page is fictional."}
    </p>

    <div class="friends-grid mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" role="list" aria-label={dict.nav.friends}>
      {
        friends.map((friend, index) => (
          <article
            role="listitem"
            class="friend-card group relative flex h-full flex-col rounded-lg border border-border bg-card p-5"
          >
            <div class="flex items-center gap-4">
              <img
                src={friend.avatar}
                alt={friend.name}
                width="96"
                height="96"
                loading={index < 3 ? "eager" : "lazy"}
                decoding="async"
                class="friend-avatar h-16 w-16 rounded-full border border-border object-cover"
              />
              <h2 class="text-lg font-bold tracking-tight">{friend.name}</h2>
            </div>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-muted-foreground">{friend.bio}</p>
            <a
              href={friend.url}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-4 inline-flex min-h-11 w-fit items-center gap-1.5 rounded-full border border-accent/40 bg-accent/10 px-4 text-sm font-semibold text-accent transition-colors hover:border-accent"
              aria-label={`${isFrench ? "Portfolio fictif de" : "Fictional portfolio of"} ${friend.name}`}
            >
              {isFrench ? "Portfolio fictif" : "Fictional portfolio"}
              <span aria-hidden="true">↗</span>
            </a>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .friends-title {
    width: fit-content;
    background: linear-gradient(
      100deg,
      var(--color-foreground),
      var(--color-accent),
      var(--color-foreground)
    );
    background-size: 200% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .friend-card {
    transition: border-color 180ms ease-out, transform 180ms ease-out;
  }
  .friend-card:hover {
    border-color: var(--color-accent);
  }
  .friend-avatar {
    background: var(--color-secondary);
    transition: border-color 200ms ease-out, transform 200ms ease-out;
  }
  .friend-card:hover .friend-avatar {
    border-color: var(--color-accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .friends-title {
      animation: friends-sheen 6s linear infinite;
    }
    .friend-card:hover {
      transform: translateY(-3px);
    }
    .friend-card:hover .friend-avatar {
      transform: scale(1.06) rotate(-2deg);
    }
    .friends-grid > * {
      animation: friend-rise 460ms ease-out both;
    }
    .friends-grid > :nth-child(2) {
      animation-delay: 70ms;
    }
    .friends-grid > :nth-child(3) {
      animation-delay: 140ms;
    }
    .friends-grid > :nth-child(4) {
      animation-delay: 210ms;
    }
    .friends-grid > :nth-child(5) {
      animation-delay: 280ms;
    }
    .friends-grid > :nth-child(6) {
      animation-delay: 350ms;
    }
  }

  @keyframes friends-sheen {
    to {
      background-position: 200% center;
    }
  }
  @keyframes friend-rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .friend-card,
    .friend-avatar {
      transition: none;
    }
  }
</style>
