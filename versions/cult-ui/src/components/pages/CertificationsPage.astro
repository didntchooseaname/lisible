---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostCard from "@/components/PostCard.astro";
import TextureLink from "@/components/react/TextureLink";
import { GradientHeading } from "@/components/ui/gradient-heading";
import { NeumorphEyebrow } from "@/components/ui/neumorph-eyebrow";
import {
  TextureCard,
  TextureCardContent,
} from "@/components/ui/texture-card";
import { localeUrl, t, type Locale } from "@/i18n/ui";
import { getPublishedPosts, postSlug, postUrl } from "@/lib/posts";
import foundationsBadge from "@shared/assets/demo-certificate-foundations.svg?url";
import systemsBadge from "@shared/assets/demo-certificate-systems.svg?url";
import accessibilityBadge from "@shared/assets/demo-certificate-accessibility.svg?url";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const isFrench = locale === "fr";
const alternates = {
  fr: localeUrl("fr", "certifications"),
  en: localeUrl("en", "certifications"),
};

const DEMO_BADGES: Record<string, string> = {
  foundations: foundationsBadge,
  systems: systemsBadge,
  accessibility: accessibilityBadge,
};

const posts = await getPublishedPosts(locale);
const postBySlug = new Map(posts.map((post) => [postSlug(post), post]));
const certifications = (await getCollection("certifications")).map(({ data }) => ({
  title: data.title,
  issuer: data.issuer,
  date: data.year,
  image: DEMO_BADGES[data.image] ?? data.image,
  description: isFrench ? data.description.fr : data.description.en,
  article: data.post ? postBySlug.get(data.post) : undefined,
}));
const reviews = certifications.flatMap((certification) =>
  certification.article ? [certification.article] : [],
);

const eyebrowClass =
  "border-border bg-secondary text-muted-foreground shadow-none";
---

<BaseLayout
  locale={locale}
  title={dict.nav.certifications}
  description={isFrench
    ? "Certifications fictives et parcours de démonstration."
    : "Fictional certifications and a demo learning path."}
  alternates={alternates}
>
  <div class="py-10 md:py-14">
    <header class="max-w-2xl">
      <NeumorphEyebrow className={eyebrowClass}>
        {isFrench ? "Parcours de démonstration" : "Demo learning path"}
      </NeumorphEyebrow>
      <GradientHeading as="h1" size="lg" weight="bold" className="tracking-tight">
        {dict.nav.certifications}
      </GradientHeading>
      <p class="mt-1 text-muted-foreground">
        {isFrench
          ? "Ces badges, organismes et parcours sont entièrement fictifs."
          : "These badges, organizations and learning paths are entirely fictional."}
      </p>
    </header>

    <section class="mt-8 grid gap-5" aria-label={dict.nav.certifications}>
      {
        certifications.map((certification, index) => (
          <TextureCard className="group">
            <TextureCardContent className="px-6 py-6 md:px-8 md:py-8">
              <div class="grid items-center gap-6 md:grid-cols-[minmax(11rem,0.55fr)_minmax(0,1.45fr)]">
                <div class="grid place-items-center rounded-3xl bg-secondary/70 p-6">
                  <img
                    src={certification.image}
                    alt={`${certification.title}, ${certification.issuer}`}
                    width="200"
                    height="200"
                    loading={index === 0 ? "eager" : "lazy"}
                    decoding="async"
                    class="h-40 w-40 object-contain motion-safe:transition-transform motion-safe:duration-200 motion-safe:group-hover:scale-[1.04] sm:h-44 sm:w-44"
                  />
                </div>
                <div>
                  <p class="text-xs font-semibold uppercase tracking-[0.14em] text-accent">
                    {certification.date} &middot; {certification.issuer}
                  </p>
                  <h2 class="mt-2 text-2xl font-bold tracking-tight text-foreground">
                    {certification.title}
                  </h2>
                  <p class="mt-3 leading-relaxed text-muted-foreground">
                    {certification.description}
                  </p>
                  {certification.article && (
                    <TextureLink
                      href={postUrl(certification.article)}
                      variant="minimal"
                      className="mt-4"
                    >
                      {isFrench
                        ? "Lire l'article de démonstration"
                        : "Read the demo article"}
                    </TextureLink>
                  )}
                </div>
              </div>
            </TextureCardContent>
          </TextureCard>
        ))
      }
    </section>

    {
      reviews.length > 0 && (
        <section
          class="mt-14 border-t border-border pt-8"
          aria-labelledby="cert-reviews-title"
        >
          <NeumorphEyebrow className={eyebrowClass}>
            {isFrench ? "Articles en série" : "Posts in this series"}
          </NeumorphEyebrow>
          <GradientHeading
            as="h2"
            size="xs"
            weight="bold"
            id="cert-reviews-title"
            className="tracking-tight"
          >
            {isFrench ? "Retours de démonstration" : "Demo reviews"}
          </GradientHeading>
          <div class="mt-4 grid gap-4 sm:grid-cols-2">
            {reviews.map((post) => (
              <PostCard post={post} />
            ))}
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>
