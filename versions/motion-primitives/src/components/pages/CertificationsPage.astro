---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { localeUrl, t, type Locale } from "@/i18n/ui";
import { getPublishedPosts, postSlug, postUrl } from "@/lib/posts";
import foundationsBadge from "@shared/assets/demo-certificate-foundations.svg?url";
import systemsBadge from "@shared/assets/demo-certificate-systems.svg?url";
import accessibilityBadge from "@shared/assets/demo-certificate-accessibility.svg?url";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const isFrench = locale === "fr";
const alternates = {
  fr: localeUrl("fr", "certifications"),
  en: localeUrl("en", "certifications"),
};

const DEMO_BADGES: Record<string, string> = {
  foundations: foundationsBadge,
  systems: systemsBadge,
  accessibility: accessibilityBadge,
};

const posts = await getPublishedPosts(locale);
const postBySlug = new Map(posts.map((post) => [postSlug(post), post]));
const certifications = (await getCollection("certifications")).map(({ data }) => ({
  title: data.title,
  issuer: data.issuer,
  year: data.year,
  image: DEMO_BADGES[data.image] ?? data.image,
  description: isFrench ? data.description.fr : data.description.en,
  article: data.post ? postBySlug.get(data.post) : undefined,
}));
---

<BaseLayout
  locale={locale}
  title={dict.nav.certifications}
  description={isFrench ? "Certifications fictives et parcours de démonstration." : "Fictional certifications and a demo learning path."}
  alternates={alternates}
>
  <div class="py-10 md:py-14">
    <p class="text-xs font-semibold uppercase tracking-[0.14em] text-accent">
      {isFrench ? "Parcours de démonstration" : "Demo learning path"}
    </p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight md:text-4xl">{dict.nav.certifications}</h1>
    <p class="mt-3 max-w-2xl text-muted-foreground">
      {
        isFrench
          ? "Ces badges, organismes et parcours sont entièrement fictifs."
          : "These badges, organizations and learning paths are entirely fictional."
      }
    </p>

    <section class="mt-10 border-t border-border" aria-label={dict.nav.certifications}>
      {
        certifications.map((certification, index) => {
          const article = certification.article;
          return (
            <article class="cert-item grid gap-6 border-b border-border py-8 md:grid-cols-[11rem_minmax(0,1fr)] md:gap-10 md:py-10">
              <div class="cert-badge flex items-start justify-center rounded-lg bg-secondary/60 p-5 md:justify-self-start">
                <img
                  src={certification.image}
                  alt={`${certification.title}, ${certification.issuer}`}
                  width="220"
                  height="220"
                  class="h-32 w-32 object-contain"
                  loading={index === 0 ? "eager" : "lazy"}
                  decoding="async"
                />
              </div>
              <div>
                <p class="font-mono text-xs uppercase tracking-wider text-muted-foreground">
                  <span class="tabular-nums">{certification.year}</span>
                  <span aria-hidden="true"> &middot; </span>
                  {certification.issuer}
                </p>
                <h2 class="mt-2 text-2xl font-bold tracking-tight md:text-3xl">{certification.title}</h2>
                <p class="mt-3 max-w-[60ch] leading-relaxed text-muted-foreground">{certification.description}</p>
                {article && (
                  <a
                    href={postUrl(article)}
                    class="cert-link mt-4 inline-flex min-h-11 items-center gap-1.5 text-sm font-medium underline decoration-accent underline-offset-4 transition-colors hover:text-accent"
                  >
                    {isFrench ? "Lire l'article de démonstration" : "Read the demo article"}
                    <span class="cert-arrow" aria-hidden="true">&rarr;</span>
                  </a>
                )}
              </div>
            </article>
          );
        })
      }
    </section>
  </div>
</BaseLayout>

<style>
  .cert-badge img {
    transition: transform 200ms ease-out;
  }
  .cert-item:hover .cert-badge img {
    transform: translateY(-3px);
  }
  .cert-arrow {
    display: inline-block;
    transition: transform 180ms ease-out;
  }
  .cert-link:hover .cert-arrow,
  .cert-link:focus-visible .cert-arrow {
    transform: translateX(3px);
  }
  @media (prefers-reduced-motion: reduce) {
    .cert-badge img,
    .cert-arrow {
      transition: none;
    }
    .cert-item:hover .cert-badge img,
    .cert-link:hover .cert-arrow,
    .cert-link:focus-visible .cert-arrow {
      transform: none;
    }
  }
</style>
