# Lisible environment variables. Copy this file to .env if needed.
# Every variable is optional: the framework builds without any of them.

# Extra hosts allowed to reach the dev and preview servers, comma separated.
# Useful when developing behind a reverse proxy. The host of SITE.url is
# always allowed.
# LISIBLE_ALLOWED_HOSTS=blog.local,preview.example.com

# Asset size budgets enforced by scripts/check-assets.ts, in bytes.
# Defaults: image 1500000, video 4000000, font 400000, other 8000000.
# ASSET_IMAGE_LIMIT_BYTES=1500000
# ASSET_VIDEO_LIMIT_BYTES=4000000
# ASSET_FONT_LIMIT_BYTES=400000
# ASSET_OTHER_LIMIT_BYTES=8000000

# Internal: set by the embedded previewer build pipeline. Do not set manually.
# LISIBLE_PREVIEW=1
# LISIBLE_PREVIEW_BASE=/_previews/organique/
# LISIBLE_PREVIEW_OUT_DIR=dist-preview
