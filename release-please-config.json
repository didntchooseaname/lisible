{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Bug fixes" },
    { "type": "perf", "section": "Performance" },
    { "type": "refactor", "section": "Refactoring" },
    { "type": "docs", "section": "Documentation" },
    { "type": "chore", "section": "Maintenance" }
  ],
  "plugins": [
    {
      "type": "linked-versions",
      "groupName": "cli",
      "components": ["lisible", "create-lisible"]
    },
    { "type": "node-workspace" }
  ],
  "packages": {
    ".": {
      "release-type": "node",
      "component": "framework",
      "include-component-in-tag": false,
      "extra-files": [
        "versions/_core/package.json",
        "versions/aceternity/package.json",
        "versions/cult-ui/package.json",
        "versions/h4x0r/package.json",
        "versions/motion-primitives/package.json",
        "versions/organique/package.json",
        "versions/reactbits/package.json"
      ]
    },
    "packages/lisible": {
      "release-type": "node",
      "component": "lisible"
    },
    "packages/create-lisible": {
      "release-type": "node",
      "component": "create-lisible"
    }
  }
}
